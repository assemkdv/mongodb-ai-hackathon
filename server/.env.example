# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=counterpart

# Voyage AI embeddings for Atlas Vector Search (Atlas -> AI Model APIs)
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# Claude
ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-opus-5
CHAT_EFFORT=low

# ElevenLabs text-to-speech. Sarah: library voices like Rachel return 402 on the free tier.
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
